# Cle d'API Google Gemini — indispensable.
# Gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Deux modeles, deux usages.
#
# Le modele allege traite les taches mecaniques : decoupage en scenes, plan
# visuel, generation de questions. Son quota gratuit est genereux.
#
# Le modele de redaction ecrit la narration. Il est plafonne a vingt requetes
# par jour en offre gratuite, soit un chapitre par requete. Au-dela, la chaine
# bascule sur le modele allege en le signalant : la prose est plus plate et les
# accents parfois perdus.
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODEL_WRITING=gemini-3.6-flash

# Voix de synthese. `edge-tts --list-voices` en montre d'autres.
TTS_VOICE=fr-FR-DeniseNeural
